# Copy to .env and fill in. Never commit the filled copy.
# Loaded with: node --env-file=.env apps/orchestrator/dist/index.js

# Where miners connect. Loopback by default; set 0.0.0.0 to accept a farm.
ZGROVE_STRATUM_HOST=127.0.0.1
ZGROVE_STRATUM_PORT=3333

# The upstream pool this proxy relays to.
ZGROVE_UPSTREAM_HOST=
ZGROVE_UPSTREAM_PORT=

# The pool account every miner is relayed under. Miners authorize with their
# own login, which is kept locally as the attribution key and never sent on.
ZGROVE_UPSTREAM_LOGIN=
ZGROVE_UPSTREAM_PASSWORD=x

# Accounting. The algorithm labels every bucket row, so it has no default.
ZGROVE_DB_PATH=data/zgrove.sqlite
ZGROVE_ALGO=

# Control plane. Hands out bearer tokens over plain HTTP, so it stays on
# loopback unless something terminates TLS in front of it.
ZGROVE_CONTROL_HOST=127.0.0.1
ZGROVE_CONTROL_PORT=3334
ZGROVE_SESSION_TTL_SECONDS=3600
# Plain user.worker logins. Off by default; only for migrating existing rigs,
# and never honoured for an account that already has an enrolled key.
# ZGROVE_ALLOW_LEGACY_LOGIN=false
# What workers are told to point their miner at, if that is not the bind host.
ZGROVE_ADVERTISED_STRATUM_HOST=

# --- contributor's machine (zgrove-worker) ---
# ZGROVE_ACCOUNT_ID=
# ZGROVE_CONTROL_URL=http://127.0.0.1:3334
# ZGROVE_WORKER_KEY_PATH=~/.zgrove/worker.key
# ZGROVE_MINER_COMMAND=lolMiner
# ZGROVE_MINER_ARGS=["--algo","EQUI144_5","--pool","{host}:{port}","--user","{token}"]

# --- treasury (zgrove send) ---
# The wallet that pays contributors. Keys live in zallet, never here.
# zcashd reached end of support on 2026-07-18 and will not start; the chain
# comes from zebrad and the wallet from zallet.
ZGROVE_ZALLET_URL=http://127.0.0.1:8232
ZGROVE_ZALLET_USER=
ZGROVE_ZALLET_PASSWORD=
ZGROVE_TREASURY_ADDRESS=
