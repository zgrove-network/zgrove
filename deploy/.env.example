# Copy to deploy/.env and fill in. deploy/.env is ignored by git and by the
# image build; nothing below that is secret belongs anywhere else.

# --- Where this runs ---------------------------------------------------------

# The hostname the control plane is served on. Caddy obtains its certificate
# for this name, so its DNS must already point at this machine.
ZGROVE_DOMAIN=pool.example.org

# What workers are told to point their miners at. Usually the same host.
ZGROVE_ADVERTISED_STRATUM_HOST=pool.example.org

# The public stratum port. Inside the container it is always 3333.
ZGROVE_STRATUM_PUBLIC_PORT=3333

# --- Upstream: the real pool this proxies to ---------------------------------

# One algorithm per process. It labels every share row, and rows written under
# the wrong one cannot be repaired afterwards.
ZGROVE_ALGO=autolykos2

ZGROVE_UPSTREAM_HOST=erg.2miners.com
ZGROVE_UPSTREAM_PORT=8888

# The account every contributor's work is relayed under. At most GPU pools
# this is simply a payout address. Required: relaying under the wrong account
# hands the work to whoever owns it.
ZGROVE_UPSTREAM_LOGIN=REPLACE_WITH_YOUR_UPSTREAM_ADDRESS.zgrove
ZGROVE_UPSTREAM_PASSWORD=x

# --- Payouts -----------------------------------------------------------------

# The shielded address payouts are sent from, recorded against each round.
ZGROVE_TREASURY_ADDRESS=REPLACE_WITH_YOUR_SHIELDED_ADDRESS

# Where settle checks a transaction id before believing it.
# ZGROVE_EXPLORER_URL=https://api.blockchair.com/zcash

# The Solana keypair `zgrove anchor` signs memos with. A path inside the
# container; see "Anchoring" in README.md for mounting it. Holds only enough SOL
# for fees — a few thousand lamports a round.
# ZGROVE_SOLANA_KEYPAIR=/secrets/solana.json

# Fee tiers, cheapest first. Leave unset for a flat rate.
# ZGROVE_FEE_TIERS=
# ZGROVE_STAKE_MINT=
# ZGROVE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Only needed to send from a node-backed wallet rather than by hand. Without
# these, pay a round from a light wallet and record it with `zgrove settle`.
# ZGROVE_ZALLET_URL=
# ZGROVE_ZALLET_USER=
# ZGROVE_ZALLET_PASSWORD=

# --- Left at their defaults on purpose ---------------------------------------

# Plain-name stratum logins. Off. Turning this on lets anyone who types an
# account name mine as that account.
# ZGROVE_ALLOW_LEGACY_LOGIN=false
