{$ZGROVE_DOMAIN} {
	reverse_proxy orchestrator:3334

	# Everything here but the public summary carries a bearer token, so
	# nothing else may be stored anywhere. The summary sets its own policy;
	# sending both headers leaves the stricter one to win, which quietly
	# turned the cache off and pointed every page load at the orchestrator.
	@private not path /v1/pool
	header @private Cache-Control "no-store"
}

# Ring's ledger, which lives in its own repository and its own containers on
# this machine. The two share nothing but this file and the network it names.
# Left out of the site above on purpose: that one is the pool's, and a
# visitor reaching the wrong service by a stray path would be told things
# about the wrong system.
# Defaults to localhost, which Caddy serves with its own internal certificate
# and never asks a public authority about. An unroutable name here instead
# had Caddy retrying Let's Encrypt every minute for a month.
{$RING_LEDGER_DOMAIN:localhost} {
	reverse_proxy api:5321

	# Balances and tokens. Nothing here may be held anywhere.
	header Cache-Control "no-store"
}
